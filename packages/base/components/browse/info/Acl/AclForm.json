        "labelIconClass": null,
        "labelIconPosition": "rear",
        "labelTooltip": null,
        "onCreated": "",
        "onMounted": "// rightDetail_userGroup\nconst _this = this\nasync function getOptions() {\n  const options = [\n        { value: 'user_roles', label: $i18n.t('user_role'), options: await roleListFilter() },\n        { value: 'user_users', label: $i18n.t('user_users'), options: await userListFilter() },\n        { value: 'user_groups', label: $i18n.t('user_groups'), options: await groupListFilter() },\n  ]\n  _this.loadOptions(options)\n}\nasync function userListFilter () {\n  const data = await $api.get('/users/select', { baseURL: '/gateway' }).then(res => res.data.data)\n  return data.reduce((prev,item) => {\n    if (item.value) prev.push({\n      label: item.label,\n      value: 'user---' + item.value\n    })\n    return prev\n  }, [])\n}\nasync function groupListFilter () {\n  const data = await $api.get('/groups/select', { baseURL: '/gateway' }).then(res => res.data.data)\n  return data.reduce((prev,item) => {\n    if (item.value) prev.push({\n      label: item.label,\n      value: 'group---' + item.value\n    })\n    return prev\n  }, [])\n}\nasync function roleListFilter () {\n  try {\n    const data = await $api.get('/api/docpal/acl/role/root').then((res) => res.data.data)\n    const roleList = data ? makeFlapRoleList([data]) : []\n    return roleList.map((item) => ({\n      label: item.name,\n      value: 'role---' + item.id\n    }))\n  } catch (error) {\n    console.error(error)\n    return []\n  }\n}\nfunction makeFlapRoleList(data, roleList = []) {\n  data.forEach((node) => {\n    const _node = { ...node }\n    delete _node.children\n    roleList.push(_node)\n    if (node.children) {\n      makeFlapRoleList(node.children, roleList)\n    }\n  })\n  return roleList\n}\ngetOptions()",
        "onRemoteQuery": "",
        "onChange": "const groudIds = []\nconst userIds = []\nconst roleIds = []\nvalue.forEach(item => {\n  const ids = item.split('---')\n  if(ids[0] === 'group') {\n    groudIds.push(ids[1])\n  } else if(ids[0] === 'role') {\n    roleIds.push(ids[1])\n  }else {\n    userIds.push(ids[1])\n  }\n})\n\nconst shareToUserIds = this.getWidgetRef('shareToUserIds')\nconst shareToGroupIds = this.getWidgetRef('shareToGroupIds')\nconst shareToRoleIds = this.getWidgetRef('shareToRoleIds')\nshareToUserIds.setValue(userIds)\nshareToGroupIds.setValue(groudIds)\nshareToRoleIds.setValue(roleIds)",
        "onFocus": "",
        "onBlur": "",
        "onValidate": ""
      },
