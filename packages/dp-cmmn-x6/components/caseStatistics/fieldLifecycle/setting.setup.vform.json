        "onChange": "const _this = this\nconst filterKey = 'masterTableColumn'\nasync function getList() {\n  try {\n    const data = await $api.post('/docpal/master/tables/record/page/nonPermission',{where:{key: 'case_status', }, name: 'basic', }).then(res => res.data.data)\n    return data.reduce((prev, item) => {\n      if(!item.name || !item.name || prev.find(p => p.value === item.name)) return prev \n      const resultItem = {\n        value: item.name,\n        label: item.name || '' ,\n        order_num: item.order_num\n      }\n      if(filterKey === 'user') resultItem.disabled = item.status === 'A' ? false : true \n      else if(filterKey === 'masterTableColumn') resultItem.disabled = !item.status\n      prev.push(resultItem) \n      return prev\n    }, []).sort((a,b)=> (a.order_num - b.order_num ))\n  } catch (e) { return [] }\n}\nasync function init() {\n  const refList = _this.refList\n  \n  const filterOptionsRef = _this.getWidgetRef('filterOptions')\n  if(value.includes('Case_Status')) {\n    const options = await getList()\n    Object.keys(refList).forEach(key => {\n      if(key.includes('filterValue@row')) {\n        const filterValueRef = refList[key]\n        filterValueRef.loadOptions(options)\n      }\n    })\n    filterOptionsRef.setValue(JSON.stringify(options))\n  } else {\n     Object.keys(refList).forEach(key => {\n      if(key.includes('filterValue@row')) {\n        const filterValueRef = refList[key]\n        filterValueRef.loadOptions([])\n      }\n    })\n    filterOptionsRef.setValue('[]')\n  }\n}\n\ninit()\n",
