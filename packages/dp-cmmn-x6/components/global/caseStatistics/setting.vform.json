                        "labelTooltip": null,
                        "onCreated": "",
                        "onMounted": "",
                        "onChange": "console.log(value)\nif(!value && !value[0] && !value[1]) return\nconst dataType = value[0]\nconst dataId = value[1]\nconst _this = this\n\nasync function getList() {\n  try {\n    const data = await $api.get(`/api/case/types/${dataId}/caseInfo`).then(res => res.data.data)\n    return data.reduce((prev, item) => {\n      if(!item.id || !item.name) return prev \n      const resultItem = {\n        value: item.id,\n        label: item.name || '' ,\n        type: item.type\n      }\n      prev.push(resultItem) \n      return prev\n    }, []).sort((a,b)=> (a.label.localeCompare(b.label) ))\n  } catch (e) { return [] }\n}\nasync function init() {\n  const options = await getList()\n  const selectFields = ['groupLabel', 'relatedField', 'groupField']\n  selectFields.forEach((field) => {\n    const widgetRef = _this.getWidgetRef(field)\n    if(widgetRef) widgetRef.loadOptions(options)\n  })\n  \n  const sortByRef = _this.getWidgetRef('sortBy')\n  sortByRef.loadOptions(options)\n  \n  const fields = _this.getWidgetRef('fields')\n  fields.setValue(JSON.stringify(options))\n  initNumberOptions(options)\n  initDateOptions(options)\n  initStrOptions(options)\n  initSubForm(options)\n}\nfunction initStrOptions(options) {\n  const strOptions = options.filter(i => ['string','short_text'].includes(i.type))\n  try {\n    const currentUserFieldRef = _this.getWidgetRef('currentUserField')\n    currentUserFieldRef.loadOptions(strOptions)\n  } catch (e) {}\n}\nfunction initDateOptions(options) {\n  const dateOptions = options.filter(i => ['date'].includes(i.type))\n  try {\n    const dateFieldRef = _this.getWidgetRef('dateField')\n    dateFieldRef.loadOptions(dateOptions)\n  } catch (e) {}\n}\nfunction initNumberOptions(options) {\n  const numberOptions = options.filter(item => ['float'].includes(item.type))\n  try {\n    const averageFieldRef = _this.getWidgetRef('lineDataField')\n    if(averageFieldRef) averageFieldRef.loadOptions(numberOptions)\n    const countFieldRef = _this.getWidgetRef('countField')\n    if(countFieldRef) countFieldRef.loadOptions(numberOptions)\n  } catch (e) {}\n}\nfunction initDialogTitle() {\n  const optionItems = _this.getOptionItems()\n  const dialogSettingTitleRef = _this.getWidgetRef('drilldownTitle')\n  const title = dialogSettingTitleRef.getValue()\n  const cur = optionItems.find(i => i.value === dataId)\n  const isTitle = !title || optionItems.find(i => i.label === title)\n  if(cur && isTitle) dialogSettingTitleRef.setValue(cur.label)\n}\nfunction initTableName() {\n  if(!dataId) return\n  \n  const dataSourceOptionsRef = _this.getWidgetRef('dataSourceOptions')\n  const optionItems = dataSourceOptionsRef.getOptionItems()\n  console.log(optionItems)\n  const cur = optionItems.find(i => i.value === dataId)\n  if(!cur) return\n  const tableNameRef = _this.getWidgetRef('tableName')\n  tableNameRef.setValue(cur.tableName)\n}\nasync function initSubForm(options) {\n  const refList = _this.refList\n  Object.keys(refList).forEach(key => {\n    if(key.includes('filterKey@row') || key.includes('filterDialogField@row') || key === 'filterKey') {\n      const filterKeyRef = refList[key]\n      filterKeyRef.loadOptions(options)\n    }\n  })\n}\ninitTableName()\ninitDialogTitle()\ninit()\n\n",
                        "onFocus": "",
                        "onBlur": "",
                        "onValidate": "",
                        "onLazyLoad": "const { level, value, childrenData } = node;\nconst dataSourceOptionsRef = this.getWidgetRef('dataSourceOptions')\nif(!!childrenData) {\n  resolve(childrenData)\n  return\n}\nconst _this = this;\nlet id = 0\nif(level === 0) {\n  const nodes =[{\n    value: 'case',\n    label: 'Case',\n    leaf: false,\n  }]\n  resolve(nodes)\n  return\n} else {\n  initOptions()\n}\n\nasync function initOptions() {\n  if(level === 1) {\n  switch (value) {\n    case 'case':\n      const options = await getList()\n      dataSourceOptionsRef.loadOptions(options)\n      resolve(options)\n      break;\n    default:\n      // code\n  }\n}\n}\nasync function getList() {\n  try {\n    const data = await $api.get('/api/case/types?deployed=true').then(res => res.data.data)\n    return data.reduce((prev, item) => {\n      if(!item.id ) return prev \n      const resultItem = {\n        value: item.id,\n        label: item.name,\n        tableName: item.tableName,\n        uniqueName: item.uniqueName,\n        leaf: 'leaf'\n      }\n      prev.push(resultItem) \n      return prev\n    }, []).sort((a,b)=> (a.label.localeCompare(b.label) ))\n  } catch (e) { return [] }\n}\n\n"
