        "labelTooltip": null,
        "onCreated": "const _this = this\nasync function getList() {\n  const data = await $api.post('/api/case/types/page',{ pageSize:9999 }).then(res => res.data.data.entryList)\n  return data.reduce((prev, item) => {\n    if(!item.id || !item.name) return prev \n const resultItem = {\n      value: item.id,\n      label: item.name || '' ,\n      versionId: item.productionVersionId\n    }\n   prev.push(resultItem) \n return prev\n  }, []).sort((a,b)=> (a.label.localeCompare(b.label) ))\n\n}\nasync function init() {\n  const options = await getList()\n  _this.loadOptions(options)\n}\ninit()",
        "onMounted": "",
        "onRemoteQuery": "",
        "onChange": "\nconst optionItems = this.getOptionItems()\nconst _this = this\nloadColumn()\nconst curCase = optionItems.find(item => item.value === value)\nif(curCase){\n  const caseLabelRef = _this.getWidgetRef('caseLabel')\n  caseLabelRef.setValue(curCase.label) \n  \n}\n\nasync function loadColumn() {\n  \n  if(!value) return\n  const options = await getOptions(value)\n  const fieldsRef = _this.getWidgetRef('fields')\n  fieldsRef.setValue(JSON.stringify(options))\n} \n\nasync function getOptions() {\n  try {\n    const data = await $api.get(`/api/case/types/${value}/caseInfo`).then(res => res.data.data)\n    return data.reduce((prev, item) => {\n      if(!item.id || !item.name) return prev \n      const resultItem = {\n        value: item.id,\n        label: item.name || '' ,\n        type: item.type\n      }\n      prev.push(resultItem) \n      return prev\n    }, [{value:'created_date', label:'workflow_createDate'},{value:'modified_date',label:'table_modifiedDate'}]).sort((a,b)=> (a.label.localeCompare(b.label) ))\n  } catch (e) { return [] }\n}",
