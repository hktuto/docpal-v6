        "onMounted": "init()\nconst _this = this\nasync function init () {\n  const groupList = await getGroupList()\n  const userList = await getUserList()\n  const list = [\n    { label: $i18n.t('user_groups'), options: groupList },\n    { label: $i18n.t('user_users'), options: userList },\n    { value: 'user_roles', label: $i18n.t('user_roles'), options: await roleListFilter() },\n  ]\n  _this.loadOptions(list)\n  // \n}\nasync function getGroupList () {\n  try {\n    const data = await $api.get('/groups/select', { baseURL: '/gateway' }).then(res => res.data.data)\n    const result = data.reduce((prev,item) => {\n      if (item.value) {\n        prev.push({\n          value: `group&&&&${item.value}`,\n          label: item.label\n        })\n      }\n      return prev\n    }, [])\n    return result.sort((a,b)=> (a.label.localeCompare(b.label) ))\n  } catch (e) {\n    return[]\n  }\n}\nasync function getUserList () {\n  try {\n    const data = await $api.get('/users/select', { baseURL: '/gateway' }).then(res => res.data.data)\n    const result =  data.reduce((prev,item) => {\n      if(item.value) {\n        prev.push({\n          value: `user&&&&${item.value}`,\n          label: item.label\n        })\n      }\n      return prev\n    }, [])\n    return result.sort((a,b)=> (a.label.localeCompare(b.label) ))\n  } catch (e) {\n    return[]\n  }\n}\nasync function roleListFilter () {\n  try {\n    const data = await $api.get('/docpal/acl/role/root').then((res) => res.data.data)\n    const roleList = data ? makeFlapRoleList([data]) : []\n    return roleList.map((item) => ({\n      label: item.name,\n      value: 'role&&&&' + item.id\n    }))\n  } catch (error) {\n    console.error(error)\n    return []\n  }\n}\nfunction makeFlapRoleList(data, roleList = []) {\n  data.forEach((node) => {\n    const _node = { ...node }\n    delete _node.children\n    roleList.push(_node)\n    if (node.children) {\n      makeFlapRoleList(node.children, roleList)\n    }\n  })\n  return roleList\n}",
