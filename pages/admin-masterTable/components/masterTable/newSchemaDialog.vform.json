        "onCreated": "const _this = this\nasync function getDocTypeList() {\n  const masterTableDataTypeList = await $api.get('/dms/master-table/dataType/mapping', {}).then(res => res.data.data)\n  const data = masterTableDataTypeList.map(item => ({\n    ...item, label: $t(`marsterTable.type.${item.value}`)\n  }))\n  data.push({\n    value: 'relation',label:  $t(`marsterTable.type.relation`)\n  })\n  return data\n}\nasync function init() {\n  const options = await getDocTypeList()\n  _this.loadOptions(options)\n}\ninit()",
