                    "onMounted": "const _this = this\nconst interval = setInterval(() => {\n  const vform = _this.getFormRef()\n  if(vform.globalOptionData.ready) {\n    clearInterval(interval)\n    _this.loadOptions(vform.globalOptionData.fileList)\n  }\n}, 1000)\n",
