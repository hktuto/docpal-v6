{
  "name": "desktop",
  "version": "1.0.1",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "tsc && concurrently \"tsc -w\" \"electron .\"",
    "dev:electron": "electron .",
    "lint": "eslint -c .eslintrc --ext .ts ./src",
    "start": "npm run build && electron .",
    "pack": "electron-builder --dir",
    "predist": "pnpm -F desktop run build",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron-windows-notifications": "^3.0.8",
    "electron-notification-state": "^1.0.4",
    "electron-notifications": "^1.0.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.3.5",
    "electron-log": "^5.4.3",
    "eslint": "^9.38.0",
    "typescript": "^5.9.3"
  }
}
